<mjml>
<mj-head>
  <mj-attributes>
    <mj-class name="content" />
  </mj-attributes>
</mj-head>
<mj-body>
  <mj-section mj-class="content">
    <mj-column>
      {{ buttons.forEach(function(button) { }}
      <mj-text>{{=button.title}}</mj-text>
      {{ }); }}
    </mj-column>
  </mj-section>
</mj-body>
</mjml>
