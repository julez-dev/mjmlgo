<mjml>
  <mj-head>
    <mj-attributes>
      <mj-accordion border="1px solid #cccccc" font-family="Roboto, Helvetica, Arial, sans-serif" icon-position="left" />
    </mj-attributes>
  </mj-head>
  <mj-body>
    <mj-section>
      <mj-column>
        <mj-accordion padding="12px 20px">
          <mj-accordion-element>
            <mj-accordion-title font-weight="bold">First question</mj-accordion-title>
            <mj-accordion-text color="#444444">First answer</mj-accordion-text>
          </mj-accordion-element>
          <mj-accordion-element background-color="#f5f5f5" icon-position="right"
                                 icon-wrapped-url="https://example.com/plus.png" icon-wrapped-alt="+"
                                 icon-unwrapped-url="https://example.com/minus.png" icon-unwrapped-alt="-"
                                 icon-width="24px" icon-height="24px" font-family="Georgia, serif">
            <mj-accordion-title font-family="monospace">Second question</mj-accordion-title>
            <mj-accordion-text font-weight="700" letter-spacing="1px" line-height="20px">Second answer</mj-accordion-text>
          </mj-accordion-element>
          <mj-accordion-element>
            <mj-accordion-title>Only a title</mj-accordion-title>
          </mj-accordion-element>
        </mj-accordion>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
