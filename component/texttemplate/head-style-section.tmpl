<!--[if !mso]><!-->
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<!--<![endif]-->
<meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<style type="text/css">
  #outlook a { padding:0; }
  body { margin:0;padding:0;-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%; }
  table, td { border-collapse:collapse;mso-table-lspace:0pt;mso-table-rspace:0pt; }
  img { border:0;height:auto;line-height:100%; outline:none;text-decoration:none;-ms-interpolation-mode:bicubic; }
  p { display:block;margin:13px 0; }
</style>
<!--[if mso]>
<noscript>
<xml>
<o:OfficeDocumentSettings>
  <o:AllowPNG/>
  <o:PixelsPerInch>96</o:PixelsPerInch>
</o:OfficeDocumentSettings>
</xml>
</noscript>
<![endif]-->
<!--[if lte mso 11]>
<style type="text/css">
  .mj-outlook-group-fix { width:100% !important; }
</style>
<![endif]-->
{{if .UsedFonts}}
<!--[if !mso]><!-->
{{range $name := .UsedFonts}}<link href="{{index $.Fonts $name}}" rel="stylesheet" type="text/css">
{{end}}
<style type="text/css">
{{range $name := .UsedFonts}}    @import url({{index $.Fonts $name}});
{{end}}
</style>
<!--<![endif]-->
{{end}}
{{ if .MediaQueryGroups }}
    <style type="text/css">
      @media only screen and (min-width:{{.Breakpoint}}) {
            {{range $group := .MediaQueryGroups}}{{range $i, $class := $group.Classes}}{{if $i}}, {{end}}.{{$class}}{{end}} {
                  {{range $group.Rules}}{{.}};
                  {{end}}
            }
            {{end}}
      }
    </style>
    <style media="screen and (min-width:{{.Breakpoint}})">
        {{range $group := .MediaQueryGroups}}{{range $i, $class := $group.Classes}}{{if $i}}, {{end}}.moz-text-html .{{$class}}{{end}} {
                {{range $group.Rules}}{{.}};
                {{end}}
        }
        {{end}}
    </style>
    {{ if .PrinterSupport }}
    <style type="text/css">
      @media only print {
            {{range $group := .MediaQueryGroups}}{{range $i, $class := $group.Classes}}{{if $i}}, {{end}}.{{$class}}{{end}} {
                  {{range $group.Rules}}{{.}};
                  {{end}}
            }
            {{end}}
      }
    </style>
    {{end}}
    {{ if .ForceOWADesktop }}
    <style type="text/css">
      {{range $group := .MediaQueryGroups}}[owa] {{range $i, $class := $group.Classes}}{{if $i}}, {{end}}.{{$class}}{{end}} {
            {{range $group.Rules}}{{.}};
            {{end}}
      }
      {{end}}
    </style>
    {{end}}
{{end}}
{{ if or .InstanceComponentHeadStyles .ComponentHeadStyles .FluidOnMobileClasses }}
<style type="text/css">
{{ range .InstanceComponentHeadStyles }}{{ . }}
{{ end }}{{ if .FluidOnMobileClasses }}    @media only screen and (max-width:{{.LowerBreakpoint}}) {
{{ range .FluidOnMobileClasses }}        table.{{ . }} { width: 100% !important; }
        td.{{ . }} { width: auto !important; }
{{ end }}    }
{{ end }}{{ range .ComponentHeadStyles }}{{ . }}
{{ end }}</style>
{{ end }}
{{ if .UserStyles }}<style type="text/css">{{ range .UserStyles }}
{{ . }}{{ end }}
</style>{{ end }}
